 {
     RISCVCPUClass *mcc = RISCV_CPU_CLASS(c);
@@ -611,6 +709,8 @@ static void riscv_cpu_class_init(ObjectClass *c, void *data)
     cc->has_work = riscv_cpu_has_work;
     cc->dump_state = riscv_cpu_dump_state;
